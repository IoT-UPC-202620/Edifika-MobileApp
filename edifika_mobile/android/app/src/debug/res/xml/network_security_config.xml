<?xml version="1.0" encoding="utf-8"?>
<!-- Solo builds de DEBUG (src/debug): permite HTTP sin TLS para desarrollo
     local: fake API o backend en la PC vistos desde el emulador (10.0.2.2),
     por `adb reverse` (localhost) o desde un teléfono en la misma red Wi-Fi
     (IP local de la PC, p. ej. 192.168.1.x). La build de release no usa este
     archivo y exige HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
