      "problemMatcher": []
    },
    {
      "label": "mobile: flutter analyze",
      "type": "shell",
      "command": "flutter analyze",
      "options": { "cwd": "${workspaceFolder}/edifika_mobile" },
      "problemMatcher": []
    },
    {
      "label": "mobile: flutter test",
      "type": "shell",
      "command": "flutter test",
      "options": { "cwd": "${workspaceFolder}/edifika_mobile" },
      "problemMatcher": []
    }
  ]
}
